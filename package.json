    "preview": "node scripts/preview.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@opencode/client": "2.1.2",
    "@opencode/plugin": "2.1.2",
    "@types/node": "^24.12.0",
